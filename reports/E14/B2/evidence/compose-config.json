  "x-common": {
    "cpus": 1,
    "environment": {
      "GIT_CONFIG_COUNT": "1",
      "GIT_CONFIG_KEY_0": "safe.directory",
      "GIT_CONFIG_VALUE_0": "/course/*",
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONPATH": "/course/labs/e8e10:/course/labs/e11e12/vendor:/app"
    },
    "healthcheck": {
      "interval": "5s",
