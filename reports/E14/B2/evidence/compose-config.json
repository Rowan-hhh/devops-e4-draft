      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8080,
          "published": "18083",
          "protocol": "tcp"
        }
      ],
      "pull_policy": "never",
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "0:0",
      "volumes": [
        {
          "type": "bind",
          "source": "/home/runner/work/devops-e4-draft/devops-e4-draft",
          "target": "/course",
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/var/run/docker.sock",
          "target": "/var/run/docker.sock",
          "bind": {
            "create_host_path": true
          }
        }
      ],
      "working_dir": "/course"
